   "source": [
    "from langchain_core.runnables import RunnableLambda\n",
    "\n",
    "runnable_sum = RunnableLambda(lambda x: sum(x))\n",
    "runnable_square = RunnableLambda(lambda x: x**2)\n",
    "\n",
    "chain = runnable_sum | runnable_square\n",
    "chain.invoke([1, 2, 5])"
   ]
  },
